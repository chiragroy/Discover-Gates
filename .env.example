# Which provider powers all 3 tiers (fast/standard/deep). Defaults to "gemini" if unset.
# One of: gemini | claude | openai
MODEL_PROVIDER=gemini

# Only the key matching MODEL_PROVIDER needs to be set. Leave unset to run fully
# offline in mock mode (no real model calls, no real cost).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
